# Copy to .env and fill locally. Never commit real API keys.
CEREBRAS_API=
NCHC_API_KEY_NAME=NCHC_API1
NCHC_API1=
LLM_MAX_COMPLETION_TOKENS=8192

# Use absolute paths. Each baseline may need a separate original environment.
# If omitted, the runner uses the current Python interpreter.
# AT_PYTHON=/absolute/path/to/transformer/bin/python
# G2S_PYTHON=/absolute/path/to/graph2smiles/bin/python
# TR_PYTHON=/absolute/path/to/template_relevance/bin/python
# RETROSIM_PYTHON=/absolute/path/to/retrosim/bin/python

# Defaults: external/baselines/<model> underneath this repository.
# AT_REPO=/absolute/path/to/augmented_transformer
# G2S_REPO=/absolute/path/to/graph2smiles
# TR_REPO=/absolute/path/to/template_relevance
# RETROSIM_REPO=/absolute/path/to/retrosim

# Optional resource overrides (otherwise original subpaths below each repo).
# AT_CHECKPOINT=/absolute/path/to/model_step_500000.pt
# G2S_CHECKPOINT=/absolute/path/to/model.500000_49.pt
# G2S_DATA_DIR=/absolute/path/to/processed
# TR_CHECKPOINT=/absolute/path/to/model_latest.pt
# TR_TEMPLATES=/absolute/path/to/templates.jsonl
# RETROSIM_DATA=/absolute/path/to/data_processed.csv

# Optional local copy or model ID for prompt-size checks; original default retained.
# TOKENIZER_NAME=Qwen/Qwen3-235B-A22B-Instruct-2507
